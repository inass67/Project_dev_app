# Copiez ce fichier en .env (ou lancez python scripts/creer_env.py), puis remplacez les valeurs.
# .env est ignoré par Git : il contient les vraies clés.
API_KEYS=remplacez-par-une-cle-client:client,remplacez-par-une-cle-admin:admin
API_KEY=remplacez-par-une-cle-client
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
